# Redactor con Groq
GROQ_API_KEY=pega_aqui_tu_clave
WRITER_LLM_MODEL=groq/openai/gpt-oss-120b

# LangSmith — trazas básicas del flujo LLM/investigación (opcional, sin clave necesaria para trazas locales)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fitfamily
LANGSMITH_API_KEY=pega_aqui_tu_clave_langsmith_opcional

# Búsqueda web alternativa (opcional; sin ella se usa DuckDuckGo mediante ddgs)
TAVILY_API_KEY=pega_aqui_tu_clave_tavily_opcional


# ==================================================
# FITFAMILY - CONFIGURACIÓN GENERAL
# ==================================================

FITFAMILY_ENVIRONMENT=development

# Directorios
FITFAMILY_DATA_DIR=data
FITFAMILY_OUTPUT_DIR=outputs/reports

# Persistencia
FITFAMILY_CHECKPOINTS_DB=data/checkpoints.sqlite
FITFAMILY_EVENTS_DB=data/fitfamily_events.sqlite
FITFAMILY_BUDGET_DB=data/budget.sqlite
FITFAMILY_TRACKING_CSV=outputs/tracking.csv

# ==================================================
# CONTROL DEL WORKFLOW
# ==================================================

FITFAMILY_MAX_REVISIONS=2
FITFAMILY_MAX_AUTOMATIC_RETRIES=1
FITFAMILY_TOOL_TIMEOUT_SECONDS=60

# ==================================================
# PRESUPUESTO DE EJECUCIÓN
# ==================================================

FITFAMILY_MAX_CALLS=50
FITFAMILY_MAX_TOKENS=100000
FITFAMILY_MAX_COST_USD=5.0
